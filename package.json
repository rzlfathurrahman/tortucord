{
  "name": "tortucord",
  "version": "1.0.0",
  "private": true,
  "description": "Open-Source Discord Bot Platform & Web Management Dashboard",
  "author": "Open Source Community",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @tortuga/database generate",
    "db:push": "pnpm --filter @tortuga/database push",
    "db:studio": "pnpm --filter @tortuga/database studio",
    "mcp": "pnpm --filter @tortuga/mcp start"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "^3.5.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.20.0"
}
