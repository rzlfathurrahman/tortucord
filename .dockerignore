# Version control
.git
**/.git
.gitignore
.gitattributes

# Dependencies (will be freshly installed inside Docker)
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store

# Build outputs & caches (will be built freshly inside Docker)
.next
**/.next
dist
**/dist
build
**/build
.turbo
**/.turbo
out
**/out
coverage
**/coverage
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets & Environment (injected dynamically at runtime via Docker Compose)
.env
.env.*
!.env.example
*.local

# Logs
*.log
**/*.log
logs
**/logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
**/.DS_Store
.idea
**/.idea
.vscode
**/.vscode
*.swp
*.swo

# Docker and Docs (not needed inside images)
docker-compose*.yml
README.md
LICENSE
